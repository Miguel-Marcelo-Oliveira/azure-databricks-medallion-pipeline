# ==============================================================================
# .gitignore — Projeto Medallion (Azure Data Factory + Databricks + Delta Lake)
# ==============================================================================
# Nada de segredo, credencial, token ou dado bruto deve chegar ao repositório.
# Os artefatos publicáveis são mantidos de propósito:
#   notebooks/*.ipynb, adf/*.json, databricks/*.yml, docs/img/*
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. Segredos, credenciais e tokens (NUNCA versionar)
# ------------------------------------------------------------------------------
# Variáveis de ambiente e arquivos de segredo
.env
.env.*
!.env.example
*.env
secrets/
secret/
*.secret
*.secrets
credentials.*
credential.*
*token*.json
*token*.txt
secrets.json
credentials.json

# Chaves e certificados
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
*.der
*.jks
*.keystore
*.ppk
*.asc
id_rsa*
id_ed25519*
id_ecdsa*
known_hosts

# Microsoft / Azure / Azure CLI
.azure/
azureProfile.json
az.json
accessTokens.json
*.publishsettings
*.pubxml
*.pubxml.user
serviceprincipal*.json
*service-principal*.json
azure-credentials.*
azureauth.json

# Azure Data Factory — configuração local/segredos
adf/local.settings.json
local.settings.json
*linkedService*.secrets.json

# Databricks — CLI e autenticação
.databrickscfg
.databricks/
databricks.cfg
*.dbc
.dbdemos/
dbx/
databricks_token*
*.pat
pat.txt

# dbt (profiles contém credenciais do warehouse)
.dbt/
profiles.yml
dbt_project/.user.yml

# Terraform / infraestrutura como código (se adicionada depois)
.terraform/
.terraform.tfstate.lock.info
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Configurações genéricas de nuvem e notebooks
.netrc
_netrc
kaggle.json
*gcloud*.json


# ------------------------------------------------------------------------------
# 2. Dados e artefatos de dados (brutos, processados e gerados)
# ------------------------------------------------------------------------------
# Diretórios de camadas e áreas de trabalho locais
data/
dados/
bronze/
silver/
gold/
raw/
landing/
checkpoints/
metadata/
warehouse/
lakehouse/
delta/
parquet/
*.delta/

# Formatos de arquivos de dados (o CSV bruto e saídas não vão para o Git)
*.csv
*.tsv
*.psv
*.parquet
*.avro
*.orc
*.jsonl
*.ndjson
*.feather
*.sas7bdat
*.rds
*.rda
*.h5
*.hdf5
