*.npz
*.pkl
*.pickle
*.joblib
*.arrow
*.xlsx
*.xlsm
*.xls
*.db
*.sqlite
*.sqlite3
*.mdb
*.accdb
*.bak
*.dump

# Delta Lake: logs transacionais gerados
_delta_log/

# Spark: saídas e estado locais
spark-warehouse/
metastore_db/
derby.log
derby.log.*
.spark/
.ivy2/
.ivy/
jars/
dbfs/


# ------------------------------------------------------------------------------
# 3. Notebooks: execução, checkpoints e cache
# ------------------------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb
*.nbconvert.ipynb
# Recomendado: use `nbstripout` para remover outputs dos notebooks antes do commit
# (os outputs podem conter e-mails e dados de clientes).


